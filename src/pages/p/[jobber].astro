---
import fetchApi from "../../lib/strapi";
import type { PlanTypes } from "../../interfaces/plan-types";
import ImageAndPDF from "../../components/image-and-pdf";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const plans = await fetchApi<PlanTypes[]>({
    endpoint: "plans", // the content type to fetch
    wrappedByKey: "data", // the key to unwrap the response
    more: true,
    fields: ["areas", "relatedPlans"],
  });

  return plans
    .filter((plan) => plan.jobber != null) // Filter out plans with null/undefined jobber
    .map((plan) => ({
      params: { jobber: String(plan.jobber) }, // Convert number to string
      props: plan,
    }));
}

const plan = Astro.props;

// TODO: testing
console.log(plan.slug);
console.log(plan.jobber);

const createdAtDate = new Date(plan.createdAt).toLocaleDateString();
const updatedAtDate = plan.updatedAt
  ? new Date(plan.updatedAt).toLocaleDateString()
  : null;

plan.notes &&
  console.error("using the old plan notes, move them to basic notes");

if (plan.relatedPlans) {
  plan.relatedPlans.forEach((relatedPlan) => {
    relatedPlan.createdAtDate = new Date(
      relatedPlan.createdAt,
    ).toLocaleDateString();
    relatedPlan.updatedAtDate = relatedPlan.updatedAt
      ? new Date(relatedPlan.updatedAt).toLocaleDateString()
      : null;
  });
}
---

<Layout>
  <h1 class="jobber">
    {plan.jobber ? plan.jobber : <span class="error">Missing Jobber</span>}
  </h1>

  <h2>{plan.name}</h2>

  <address class="capitalize">
    <span class="kilimanjaro">{plan.address}</span><br />
    {
      plan?.areas?.[0]?.name ?? (
        <span class="error">No area name available</span>
      )
    },
    {plan?.areas?.[0]?.state ?? <span class="error">No state available</span>}, {
      plan.zip
    }
  </address>

  <hr />

  <p>
    {
      plan.timerHours || plan.timerFallback ? (
        `Timer: ${plan.timerHours ? plan.timerHours + " hours" : plan.timerFallback}`
      ) : (
        <span class="error">Missing Timer Info</span>
      )
    }
  </p>

  {
    plan.basicNotes ? (
      <>
        <h2>Notes</h2>
        <pre>{plan.basicNotes}</pre>
      </>
    ) : null
  }

  {
    plan.notes ? (
      <>
        <p class="error">There are Notes instead of Block Notes</p>
        <h2>Old Notes</h2>
        {plan.notes}
      </>
    ) : null
  }

  <ImageAndPDF
    plan={plan}
    createdAtDate={createdAtDate}
    updatedAtDate={updatedAtDate ?? ""}
    showPlan={true}
    client:load
  />

  <hr />

  <p>Created at {createdAtDate}</p>
  {updatedAtDate !== createdAtDate ? <p>Updated at {updatedAtDate}</p> : null}

  <hr />

  {
    plan.relatedPlans && plan.relatedPlans.length > 0 ? (
      <section>
        <h2>Related Plans</h2>
        <ul>
          {plan.relatedPlans.map((relatedPlan) => (
            <article>
              <a href={`/p/${relatedPlan.slug}`}>{relatedPlan.name}</a>
              <ImageAndPDF
                plan={relatedPlan}
                createdAtDate={relatedPlan.createdAtDate}
                updatedAtDate={relatedPlan.updatedAtDate ?? ""}
                showPlan={false}
                client:load
              />
            </article>
          ))}
        </ul>
      </section>
    ) : null
  }
</Layout>
